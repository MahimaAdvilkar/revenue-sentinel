# Revenue Sentinel — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# NAMES ONLY BELOW — no real values, no secrets, ever (rule 12).
#
#     cp .env.example .env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local                  # local | ci
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                # json | console

# ---------------------------------------------------------------------------
# Database
#
# HOST PORT 55432 IS DELIBERATE — a local Homebrew PostgreSQL occupies 5432.
# Pointing this at 5432 would silently connect to the wrong database.
# ---------------------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=             # set a local-only value; never a real credential
POSTGRES_DB=revenue_sentinel
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgresql+psycopg://sentinel:CHANGEME@localhost:55432/revenue_sentinel

# ---------------------------------------------------------------------------
# Demo mode — see ADR-0007
#
#   fixture : replay recorded model responses. OFFLINE. No API key. THE DEFAULT.
#   live    : real Claude API calls. Requires ANTHROPIC_API_KEY. Costs money.
#   record  : real calls that also write fixtures. Costs money.
# ---------------------------------------------------------------------------
DEMO_MODE=fixture

# ---------------------------------------------------------------------------
# Anthropic API — required ONLY for DEMO_MODE=live or record.
# Leave blank for the default offline path.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Model routing — see docs/cost-governance.md §3
MODEL_DEFAULT=claude-opus-5
MODEL_UTILITY=claude-haiku-4-5
MODEL_EFFORT_DEFAULT=high      # low | medium | high | xhigh | max

# ---------------------------------------------------------------------------
# Cost governance — deliberately low. A demo that can accidentally spend $200
# is a demo with a design flaw. See docs/cost-governance.md §2.
# ---------------------------------------------------------------------------
BUDGET_RUN_USD=0.50
BUDGET_INCIDENT_USD=2.00
BUDGET_GLOBAL_MONTHLY_USD=25.00

# Non-monetary ceilings — the cheapest failure mode is a loop that never bills
# much and never terminates either.
LIMIT_MODEL_CALLS_PER_RUN=12
LIMIT_TOOL_CALLS_PER_RUN=30
LIMIT_NODE_EXECUTIONS_PER_RUN=40
LIMIT_RUN_WALLCLOCK_SECONDS=300

# ---------------------------------------------------------------------------
# Determinism — the demo must produce identical output every time.
# ---------------------------------------------------------------------------
SEED=20260801
EVALUATION_TIMESTAMP=2026-08-01T12:00:00Z   # injected; never read from the clock

# ---------------------------------------------------------------------------
# Detector thresholds — stalled_opportunity. See docs/event-model.md §4.
# ---------------------------------------------------------------------------
DETECTOR_MIN_AMOUNT_USD=100000
DETECTOR_INACTIVITY_DAYS=14
DETECTOR_USAGE_GROWTH_PCT=40

# ---------------------------------------------------------------------------
# Governance
# ---------------------------------------------------------------------------
APPROVAL_EXPIRY_HOURS=72
POLICY_VERSION=v1

# ---------------------------------------------------------------------------
# Frontend (Session 9)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# NOT USED IN v1 — listed so it is clear they are absent by design, not omitted
# by accident. No real integration credentials belong in this repository.
#
# HUBSPOT_API_KEY=       # ROADMAP — see ADR-0004
# SALESFORCE_CLIENT_ID=  # ROADMAP
# GMAIL_CLIENT_ID=       # ROADMAP
# SLACK_BOT_TOKEN=       # ROADMAP
# ---------------------------------------------------------------------------
