  "info": {
    "description": "Agentic AI GTM Control Tower. Every external integration is SIMULATED in v1 -- see CAPABILITY_MATRIX.md.",
    "title": "Revenue Sentinel",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/approvals": {
      "get": {
        "description": "The inbox. **Read-only** -- it renders the command, it does not run it.\n\nThere is no authentication in this system, so a browser button would imply a session\nand an accountable user that do not exist (ADR-0018, ADR-0022).",
        "operationId": "approvals_approvals_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalInboxResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Approvals",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/evaluation/latest": {
      "get": {
        "description": "The most recent evaluation attempt. History is append-only, so this is a view of\none attempt rather than a mutable status.",
        "operationId": "evaluation_evaluation_latest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "summary": "Evaluation",
        "tags": [
          "dashboard"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report process health and whether PostgreSQL answers.\n\nReturns 503 when the database is unreachable so an orchestrator can act on the\nstatus code rather than having to parse the body.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "A dependency is unreachable"
          }
        },
        "summary": "Liveness and dependency reachability",
        "tags": [
          "health"
        ]
      }
    },
    "/incidents": {
      "get": {
        "description": "The incident queue.\n\nOrdered by `opened_at` descending then `incident_ref`, so the ordering is total\neven when several incidents share an instant -- which they do, because the\nevaluation timestamp is frozen.",
        "operationId": "list_incidents_incidents_get",
        "parameters": [
          {
            "description": "Filter by lifecycle status",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/IncidentStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by lifecycle status",
              "title": "Status"
            }
          },
          {
            "description": "Filter by severity",
            "in": "query",
            "name": "severity",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Severity"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by severity",
              "title": "Severity"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List incidents, newest first",
        "tags": [
          "incidents"
        ]
      }
    },
    "/incidents/{incident_ref}": {
      "get": {
        "description": "Fetch an incident by its business reference, e.g. `INC-001`.",
